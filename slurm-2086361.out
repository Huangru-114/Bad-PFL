  gaussian_global              2    1   0.3120    0.3120    -0.0824     0.2306
  gaussian_layer_matched       1    0   0.1560    0.1560     0.3619     0.0000
  gaussian_layer_matched       1    1   0.1560    0.1560    -0.0792     0.0000
  gaussian_layer_matched       2    0   0.3120    0.3120     0.3619     0.0000
  gaussian_layer_matched       2    1   0.3120    0.3120    -0.0792     0.0000
  shuffled                     1    0   0.1560    0.1560     0.9000     0.0000
  shuffled                     1    1   0.1560    0.1560     0.9500     0.0000
  shuffled                     2    0   0.3120    0.3120     0.9000     0.0000
